<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ViewData["BusinessName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <nav class="navbar navbar-expand-lg navbar-dark desk-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">@ViewData["BusinessName"]</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-nav" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="site-nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Plans">Plans</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Trainers">Trainers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Schedule">Schedule</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Rules">Rules</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (User.IsInRole(AppRoles.Staff) || User.IsInRole(AppRoles.Manager))
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Reception" asp-action="Index">Front desk</a></li>
                    }
                    else if (User.IsInRole(AppRoles.Member))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Portal" asp-action="Index">My account</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li class="nav-item"><a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">Join</a></li>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button class="btn btn-sm btn-outline-light" type="submit">Sign out</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    <footer class="desk-footer">
        <div class="container d-flex justify-content-between">
            <span>@ViewData["BusinessName"]</span>
            <a asp-controller="Staff" asp-action="Login">Staff sign in</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
