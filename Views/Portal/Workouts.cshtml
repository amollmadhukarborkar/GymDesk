@model List<WorkoutRecord>
@{
    ViewData["Title"] = "Workouts";
}
<h1 class="h3">Workouts</h1>
<table class="table bg-white">
    <thead><tr><th>Date</th><th>Minutes</th></tr></thead>
    <tbody>
        @foreach (var workout in Model)
        {
            <tr><td>@workout.WorkoutDate.ToString("dd MMM yyyy")</td><td>@workout.DurationMinutes</td></tr>
        }
    </tbody>
</table>
