@model ProfileInput
@{
    ViewData["Title"] = "Profile";
}
<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" class="panel" asp-action="Profile">
            <h1 class="h4">Profile</h1>
            <div class="row">
                <div class="col-md-6 mb-3"><label class="form-label" asp-for="FirstName"></label><input class="form-control" asp-for="FirstName" /></div>
                <div class="col-md-6 mb-3"><label class="form-label" asp-for="LastName"></label><input class="form-control" asp-for="LastName" /></div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3"><label class="form-label" asp-for="City"></label><input class="form-control" asp-for="City" /></div>
                <div class="col-md-5 mb-3"><label class="form-label" asp-for="Street"></label><input class="form-control" asp-for="Street" /></div>
                <div class="col-md-3 mb-3"><label class="form-label" asp-for="HouseNumber"></label><input class="form-control" asp-for="HouseNumber" /></div>
            </div>
            <button class="btn btn-dark" type="submit">Save</button>
        </form>
    </div>
    <div class="col-lg-5">
        <form method="post" class="panel" asp-action="Password">
            <h2 class="h5">Change password</h2>
            <div class="mb-3"><label class="form-label">Current password</label><input class="form-control" type="password" name="CurrentPassword" /></div>
            <div class="mb-3"><label class="form-label">New password</label><input class="form-control" type="password" name="NewPassword" /></div>
            <button class="btn btn-outline-dark" type="submit">Update password</button>
        </form>
        <form method="post" asp-action="Close" class="mt-3" data-confirm="Close your account and remove your membership record?">
            <button class="btn btn-outline-danger" type="submit">Close account</button>
        </form>
    </div>
</div>
