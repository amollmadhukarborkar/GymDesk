@model List<Invoice>
@{
    ViewData["Title"] = "Invoices";
}
<h1 class="h3">Invoices</h1>
<input class="form-control mb-3" data-table-filter="#invoice-table" placeholder="Filter invoices" />
<table class="table bg-white" id="invoice-table">
    <thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Method</th></tr></thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            <tr>
                <td>@invoice.IssuedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td>@invoice.Description</td>
                <td>@Money.Format(invoice.Amount, ViewData["Currency"] as string)</td>
                <td>@invoice.PaymentChannel</td>
            </tr>
        }
    </tbody>
</table>
