@model LoginInput
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Sign in";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <form method="post" class="panel" asp-action="Login">
            <h1 class="h3">Member sign in</h1>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" />
            </div>
            <button class="btn btn-dark w-100" type="submit">Sign in</button>
            <p class="mt-3 mb-0"><a asp-action="Register">Create an account</a></p>
            @if (Env.IsDevelopment())
            {
                <p class="small text-secondary mt-3 mb-0">Local sample member: member@example.com / Member123! · code 10000001</p>
            }
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
