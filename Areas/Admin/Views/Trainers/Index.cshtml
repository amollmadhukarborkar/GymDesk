@model List<Trainer>
@{
    ViewData["Title"] = "Trainers";
    var editing = ViewBag.Editing as Trainer;
}
<h1 class="h3">Trainers</h1>
<form method="post" asp-action="Save" enctype="multipart/form-data" class="panel mb-4">
    <input type="hidden" name="Id" value="@(editing?.Id ?? 0)" />
    <div class="row g-2">
        <div class="col-md-4"><input class="form-control" name="FullName" value="@editing?.FullName" placeholder="Name" required /></div>
        <div class="col-md-2"><input class="form-control" name="HourlyRate" type="number" step="0.01" min="0" value="@(editing?.HourlyRate ?? 0)" /></div>
        <div class="col-md-2"><input class="form-control" name="TenSessionRate" type="number" step="0.01" min="0" value="@(editing?.TenSessionRate ?? 0)" /></div>
        <div class="col-md-4"><input class="form-control" type="file" name="Photo" accept="image/*" /></div>
        <div class="col-12"><textarea class="form-control" name="Biography" rows="3" placeholder="Biography">@editing?.Biography</textarea></div>
    </div>
    <button class="btn btn-dark mt-3" type="submit">Save trainer</button>
</form>
<div class="row g-3">
    @foreach (var trainer in Model)
    {
        <div class="col-md-6">
            <article class="panel">
                <h2 class="h5">@trainer.FullName</h2>
                <p>@trainer.Biography</p>
                <p>Hour @Money.Format(trainer.HourlyRate, ViewData["Currency"] as string) · Ten sessions @Money.Format(trainer.TenSessionRate, ViewData["Currency"] as string)</p>
                <a asp-action="Index" asp-route-id="@trainer.Id">Edit</a>
                <form method="post" asp-action="Delete" asp-route-id="@trainer.Id" class="d-inline" data-confirm="Remove this trainer?">
                    <button class="btn btn-link btn-sm" type="submit">Remove</button>
                </form>
            </article>
        </div>
    }
</div>
