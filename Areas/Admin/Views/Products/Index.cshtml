@model List<Product>
@{
    ViewData["Title"] = "Products";
    var editing = ViewBag.Editing as Product;
}
<h1 class="h3">Products</h1>
<form method="post" asp-action="Save" class="panel mb-4">
    <input type="hidden" name="Id" value="@(editing?.Id ?? 0)" />
    <div class="row g-2">
        <div class="col-md-4"><input class="form-control" name="Name" value="@editing?.Name" placeholder="Name" required /></div>
        <div class="col-md-2"><input class="form-control" name="Price" type="number" step="0.01" min="0" value="@(editing?.Price ?? 0)" /></div>
        <div class="col-md-2"><input class="form-control" name="StockQuantity" type="number" min="0" value="@(editing?.StockQuantity ?? 0)" /></div>
        <div class="col-md-4"><input class="form-control" name="Barcode" value="@editing?.Barcode" placeholder="Barcode" required /></div>
        <div class="col-12"><input class="form-control" name="Description" value="@editing?.Description" placeholder="Description" /></div>
    </div>
    <button class="btn btn-dark mt-3" type="submit">Save product</button>
</form>
<table class="table bg-white">
    <thead><tr><th>Name</th><th>Barcode</th><th>Stock</th><th>Price</th><th></th></tr></thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Barcode</td>
                <td>@product.StockQuantity</td>
                <td>@Money.Format(product.Price, ViewData["Currency"] as string)</td>
                <td>
                    <a asp-action="Index" asp-route-id="@product.Id">Edit</a>
                    <form method="post" asp-action="Delete" asp-route-id="@product.Id" class="d-inline" data-confirm="Remove this product?">
                        <button class="btn btn-link btn-sm" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
