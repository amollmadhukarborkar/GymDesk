@model MemberEditInput
@{
    ViewData["Title"] = "Edit member";
}
<form method="post" class="panel" asp-action="Edit">
    <h1 class="h4">@ViewBag.MemberCode</h1>
    <p>Balance @Money.Format((decimal)ViewBag.Balance, ViewData["Currency"] as string)</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label" asp-for="FirstName"></label><input class="form-control" asp-for="FirstName" /></div>
        <div class="col-md-6 mb-3"><label class="form-label" asp-for="LastName"></label><input class="form-control" asp-for="LastName" /></div>
    </div>
    <div class="mb-3"><label class="form-label" asp-for="Email"></label><input class="form-control" asp-for="Email" /></div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label" asp-for="Gender"></label>
            <select class="form-select" asp-for="Gender">
                <option>Female</option>
                <option>Male</option>
                <option>Other</option>
            </select>
        </div>
        <div class="col-md-4 mb-3"><label class="form-label" asp-for="City"></label><input class="form-control" asp-for="City" /></div>
        <div class="col-md-4 mb-3"><label class="form-label" asp-for="HouseNumber"></label><input class="form-control" asp-for="HouseNumber" /></div>
    </div>
    <div class="mb-3"><label class="form-label" asp-for="Street"></label><input class="form-control" asp-for="Street" /></div>
    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="IsConfirmed" />
        <label class="form-check-label" asp-for="IsConfirmed">Confirmed</label>
    </div>
    <button class="btn btn-dark" type="submit">Save</button>
    <a class="btn btn-link" asp-action="Index">Back</a>
</form>
<form method="post" asp-action="Delete" class="mt-3" data-confirm="Remove this member and their passes, invoices, and visits?">
    <button class="btn btn-outline-danger" type="submit">Remove member</button>
</form>
