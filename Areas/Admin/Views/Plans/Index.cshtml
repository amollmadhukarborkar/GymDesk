@model List<MembershipPlan>
@{
    ViewData["Title"] = "Plans";
    var editing = ViewBag.Editing as MembershipPlan;
}
<h1 class="h3">Plans</h1>
<form method="post" asp-action="Save" class="panel mb-4">
    <input type="hidden" name="Id" value="@(editing?.Id ?? 0)" />
    <div class="row g-2">
        <div class="col-md-4"><input class="form-control" name="Name" value="@editing?.Name" placeholder="Name" required /></div>
        <div class="col-md-2"><input class="form-control" name="ValidDays" type="number" min="1" value="@(editing?.ValidDays ?? 30)" placeholder="Days" /></div>
        <div class="col-md-2"><input class="form-control" name="VisitAllowance" type="number" min="1" value="@editing?.VisitAllowance" placeholder="Visits" /></div>
        <div class="col-md-2"><input class="form-control" name="Price" type="number" step="0.01" min="0" value="@(editing?.Price ?? 0)" /></div>
        <div class="col-md-2 form-check mt-2">
            @if (editing is null || editing.IsActive)
            {
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="plan-active" checked />
            }
            else
            {
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="plan-active" />
            }
            <input type="hidden" name="IsActive" value="false" />
            <label class="form-check-label" for="plan-active">Active</label>
        </div>
    </div>
    <p class="small text-secondary mt-2 mb-2">Leave visits empty for an unlimited pass.</p>
    <button class="btn btn-dark" type="submit">Save plan</button>
</form>
<table class="table bg-white">
    <thead><tr><th>Name</th><th>Days</th><th>Visits</th><th>Price</th><th>Active</th><th></th></tr></thead>
    <tbody>
        @foreach (var plan in Model)
        {
            <tr>
                <td>@plan.Name</td>
                <td>@plan.ValidDays</td>
                <td>@(plan.VisitAllowance?.ToString() ?? "Unlimited")</td>
                <td>@Money.Format(plan.Price, ViewData["Currency"] as string)</td>
                <td>@(plan.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Index" asp-route-id="@plan.Id">Edit</a>
                    <form method="post" asp-action="Delete" asp-route-id="@plan.Id" class="d-inline" data-confirm="Remove this plan?">
                        <button class="btn btn-link btn-sm" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
